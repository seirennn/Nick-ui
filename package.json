{
  "name": "@sehrennn/nickui",
  "version": "0.1.1",
  "description": "Architectural developer-owned UI components and open-source AI MCP server with tactile depth.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seirennn/Nick-ui.git"
  },
  "bugs": {
    "url": "https://github.com/seirennn/Nick-ui/issues"
  },
  "homepage": "https://github.com/seirennn/Nick-ui#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nickui": "bin/nickui.js"
  },
  "files": [
    "dist",
    "bin",
    "registry",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "ui",
    "react",
    "components",
    "shadcn",
    "mcp",
    "model-context-protocol",
    "tailwind",
    "tactile",
    "skeuomorphism",
    "design-system"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "tsup",
    "build:registry": "node scripts/build-registry.js",
    "start": "next start",
    "lint": "next lint",
    "prepublishOnly": "pnpm build:lib && pnpm build:registry"
  },
  "peerDependencies": {
    "framer-motion": ">=11.0.0",
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@tailwindcss/postcss": "^4.0.9",
    "commander": "^15.0.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "15.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}